#!/usr/bin/env python3
"""Citadel's connection monitor: runs citadel.monitor with this OS's backend.

Kept as a script so the daemon (and packages) start it by path. Finds the
citadel package in a checkout (../), $CITADEL_HOME, or /usr/share/citadel.
"""
import os
import sys

here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
home = os.environ.get("CITADEL_HOME") or (here if os.path.isdir(os.path.join(here, "citadel")) else "/usr/share/citadel")
sys.path.insert(0, home)

from citadel.monitor.__main__ import main  # noqa: E402

main()
