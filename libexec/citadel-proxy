#!/usr/bin/env python3
"""Citadel's proxy as a process (the Omarchy plugin starts it by path; the
app's daemon runs citadel.proxy in its own event loop instead).

Finds the citadel package in a checkout (../), $CITADEL_HOME, or /usr/share/citadel.
"""
import asyncio
import os
import sys

here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
home = os.environ.get("CITADEL_HOME") or (here if os.path.isdir(os.path.join(here, "citadel")) else "/usr/share/citadel")
sys.path.insert(0, home)

from citadel.proxy import main  # noqa: E402

try:
    asyncio.run(main())
except KeyboardInterrupt:
    pass
